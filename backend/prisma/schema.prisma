// Atelier Forge Database Schema
// Version 3.0 - November 2025

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          UserRole  @default(CONSULTANT)
  experienceLevel ExperienceLevel @default(CONFIRMED)
  sector        String?   // Default sector for context
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  sheets        Sheet[]
  workshops     Workshop[]
  feedbacks     SheetFeedback[]
  validations   SheetValidation[]  @relation("ValidatedBy")
  templates     Template[]
  notifications Notification[]

  @@map("users")
}

enum UserRole {
  CONSULTANT
  MANAGER
  ADMIN
}

enum ExperienceLevel {
  BEGINNER    // < 2 years
  CONFIRMED   // 2-5 years
  EXPERT      // > 5 years
}

// ============================================
// COMPETENCY REFERENTIAL
// ============================================

model Competency {
  id          String   @id @default(uuid())
  code        String   @unique  // e.g., "C5.4"
  axis        String   // e.g., "C5"
  axisName    String   // e.g., "Relationnel"
  title       String   // Full competency title
  description String?  // Detailed description
  keywords    String[] // Search keywords
  order       Int      // Display order
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sheets      Sheet[]
  workshops   WorkshopCompetency[]

  @@map("competencies")
}

// ============================================
// WORKSHOP (ATELIER COMPLET) - Sprint 16
// ============================================

model Workshop {
  id              String         @id @default(uuid())
  title           String         // Free subject/theme of the workshop
  description     String?        // Brief description
  status          WorkshopStatus @default(DRAFT)
  confidenceScore Int            @default(0)  // 0-100
  version         Int            @default(1)

  // Context
  sector          String
  audienceType    String
  format          SheetFormat    @default(IN_PERSON)
  duration        Int            @default(120) // Total duration in minutes
  participantMin  Int            @default(6)
  participantMax  Int            @default(12)

  // Content (stored as JSON)
  introduction    Json?          // Welcome, ice-breaker, objectives presentation
  timeline        Json?          // Overall workshop timeline/schedule
  activities      Json?          // Array of workshop activities/sequences
  materials       Json?          // Required materials list
  trainerNotes    Json?          // Tips and guidance for trainer
  evaluation      Json?          // Global evaluation strategy
  synthesis       Json?          // Conclusion and key takeaways

  // AI Metadata
  aiGenerationId  String?
  aiModel         String?
  perplexityCalls Int            @default(0)
  claudeCalls     Int            @default(0)
  totalCost       Float          @default(0)

  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  validatedAt     DateTime?

  // Relations
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  competencies    WorkshopCompetency[]
  sheets          Sheet[]        // Individual activity sheets within workshop

  @@index([userId])
  @@index([status])
  @@map("workshops")
}

// Junction table for Workshop <-> Competency (many-to-many)
model WorkshopCompetency {
  id           String     @id @default(uuid())
  workshopId   String
  competencyId String
  isPrimary    Boolean    @default(false) // Main competency vs secondary
  coverageLevel Int       @default(50)    // 0-100 how much this competency is covered

  workshop     Workshop   @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  competency   Competency @relation(fields: [competencyId], references: [id])

  @@unique([workshopId, competencyId])
  @@map("workshop_competencies")
}

enum WorkshopStatus {
  DRAFT
  GENERATING
  PENDING_REVIEW
  VALIDATED
  ARCHIVED
}

// ============================================
// SHEET (FICHE DE CONCEPTION)
// ============================================

model Sheet {
  id              String      @id @default(uuid())
  title           String
  status          SheetStatus @default(DRAFT)
  confidenceScore Int         @default(0)  // 0-100
  version         Int         @default(1)

  // Context
  sector          String
  audienceType    String
  format          SheetFormat @default(IN_PERSON)
  constraints     String[]    // Array of constraint codes
  priorities      String[]    // Array of priority codes
  duration        Int         @default(75) // Duration in minutes

  // Content (stored as JSON)
  content         Json?       // Full content object (Sprint 7+)
  objectives      Json        // Array of objectives
  situations      Json        // Array of professional situations
  flow            Json        // Array of flow phases
  evaluation      Json        // Evaluation criteria
  resources       Json?       // Additional resources

  // Public Sharing (Sprint 7)
  shareToken      String?     @unique
  shareExpiresAt  DateTime?

  // AI Metadata
  aiGenerationId  String?     // Track generation session
  aiModel         String?     // Model used for generation
  perplexityCalls Int         @default(0)
  claudeCalls     Int         @default(0)
  totalCost       Float       @default(0)

  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  validatedAt     DateTime?
  archivedAt      DateTime?

  // Relations
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  competencyId    String
  competency      Competency  @relation(fields: [competencyId], references: [id])
  workshopId      String?     // Optional: if this sheet is part of a workshop
  workshop        Workshop?   @relation(fields: [workshopId], references: [id])
  validations     SheetValidation[]
  feedbacks       SheetFeedback[]
  versions        SheetVersion[]
  quiz            Quiz?

  @@index([userId])
  @@index([competencyId])
  @@index([workshopId])
  @@index([status])
  @@map("sheets")
}

enum SheetStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  ARCHIVED
}

enum SheetFormat {
  IN_PERSON       // Présentiel
  REMOTE_SYNC     // Distanciel synchrone
  REMOTE_ASYNC    // Distanciel asynchrone
  HYBRID          // Hybride
}

// ============================================
// SHEET VERSION HISTORY
// ============================================

model SheetVersion {
  id          String   @id @default(uuid())
  versionNum  Int
  content     Json     // Full sheet content snapshot
  changeNote  String?  // Description of changes
  createdAt   DateTime @default(now())

  // Relations
  sheetId     String
  sheet       Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@unique([sheetId, versionNum])
  @@map("sheet_versions")
}

// ============================================
// VALIDATION WORKFLOW
// ============================================

model SheetValidation {
  id          String           @id @default(uuid())
  status      ValidationStatus
  comments    String?
  createdAt   DateTime         @default(now())

  // Relations
  sheetId     String
  sheet       Sheet            @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  validatorId String
  validator   User             @relation("ValidatedBy", fields: [validatorId], references: [id])

  @@map("sheet_validations")
}

enum ValidationStatus {
  APPROVED
  REJECTED
  NEEDS_CHANGES
}

// ============================================
// POST-WORKSHOP FEEDBACK
// ============================================

model SheetFeedback {
  id              String   @id @default(uuid())
  workshopDate    DateTime
  participantCount Int
  overallRating   Int      // 1-5
  situationRatings Json    // { "S1": "top", "S2": "bof", ... }
  timingFeedback  String   // "short", "perfect", "long"
  timingNote      String?
  comments        String?
  createdAt       DateTime @default(now())

  // Relations
  sheetId         String
  sheet           Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id])

  @@map("sheet_feedbacks")
}

// ============================================
// QUIZ
// ============================================

model Quiz {
  id          String   @id @default(uuid())
  questions   Json     // Array of quiz questions
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sheetId     String   @unique
  sheet       Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@map("quizzes")
}

// ============================================
// TEMPLATES
// ============================================

model Template {
  id          String       @id @default(uuid())
  name        String
  description String?
  type        TemplateType
  content     Json         // Template configuration
  isPublic    Boolean      @default(false)
  usageCount  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  userId      String
  user        User         @relation(fields: [userId], references: [id])

  @@map("templates")
}

enum TemplateType {
  DISCOVERY       // Découverte
  IMPROVEMENT     // Perfectionnement
  REMEDIATION     // Remédiation
  CUSTOM          // Personnalisé
}

// ============================================
// AI GENERATION SESSIONS
// ============================================

model GenerationSession {
  id              String   @id @default(uuid())
  status          GenerationStatus
  inputContext    Json     // Original user input
  enrichmentData  Json?    // Perplexity results
  generatedContent Json?   // Initial generation
  validationResult Json?   // Validation analysis
  finalContent    Json?    // After improvements

  // Metrics
  totalDuration   Int?     // Total time in ms
  perplexityCalls Int      @default(0)
  claudeCalls     Int      @default(0)
  totalTokensIn   Int      @default(0)
  totalTokensOut  Int      @default(0)
  estimatedCost   Float    @default(0)

  // Timestamps
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@map("generation_sessions")
}

enum GenerationStatus {
  PENDING
  ENRICHING
  GENERATING
  VALIDATING
  IMPROVING
  COMPLETED
  FAILED
}

// ============================================
// WORKSHOP GENERATION SESSIONS - Sprint 16
// ============================================

model WorkshopGenerationSession {
  id                String                    @id @default(uuid())
  status            WorkshopGenerationStatus

  // Input
  subject           String                    // Free text workshop subject
  competencyIds     String[]                  // Array of competency IDs
  inputContext      Json                      // Full user input

  // Intermediate results
  structureData     Json?                     // Workshop structure planning
  activitiesData    Json?                     // Generated activities
  enrichmentData    Json?                     // Perplexity context
  validationResult  Json?                     // Validation analysis

  // Final output
  finalContent      Json?                     // Complete workshop content

  // Metrics
  totalDuration     Int?                      // Total time in ms
  perplexityCalls   Int                       @default(0)
  claudeCalls       Int                       @default(0)
  totalTokensIn     Int                       @default(0)
  totalTokensOut    Int                       @default(0)
  estimatedCost     Float                     @default(0)

  // Timestamps
  startedAt         DateTime                  @default(now())
  completedAt       DateTime?

  // Relations
  userId            String

  @@index([userId])
  @@map("workshop_generation_sessions")
}

enum WorkshopGenerationStatus {
  PENDING
  ANALYZING           // Analyzing subject + competencies
  STRUCTURING         // Creating workshop structure
  GENERATING_INTRO    // Generating introduction
  GENERATING_ACTIVITIES // Generating each activity
  GENERATING_EVALUATION // Generating evaluation
  VALIDATING          // AI validation
  IMPROVING           // Auto-improvements
  COMPLETED
  FAILED
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType
  title       String
  message     String
  data        Json?            // Additional context (sheetId, etc.)
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  // Relations
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  VALIDATION_REQUESTED    // Sheet submitted for validation
  VALIDATION_APPROVED     // Sheet approved by manager
  VALIDATION_REJECTED     // Sheet rejected by manager
  VALIDATION_NEEDS_CHANGES // Sheet needs modifications
  SHEET_REMIXED           // Your sheet was remixed
  COMMENT_ADDED           // New comment on your sheet
}

// ============================================
// EXPORT LOG (Sprint 8 - SCORM)
// ============================================

model ExportLog {
  id          String       @id @default(uuid())
  exportType  String       // "SCORM", "DOCX", "PDF", etc.
  format      String?      // SCORM version or format details
  success     Boolean
  errorMessage String?
  fileSize    Int?         // Size in bytes
  exportedAt  DateTime     @default(now())

  // Relations
  sheetId     String?      // For sheet exports
  workshopId  String?      // For workshop exports (Sprint 16)
  userId      String

  @@index([sheetId])
  @@index([workshopId])
  @@index([userId])
  @@index([exportType])
  @@map("export_logs")
}
